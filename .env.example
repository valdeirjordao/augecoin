# AUGECOIN — example environment configuration
#
# Copy to `.env` and adjust. Load before starting the node:
#     set -a; . ./.env; set +a
#     ./target/release/augecoin-node

# ── Identity ──────────────────────────────────────────────────────────
# One of these three is required:
#AUGECOIN_VALIDATOR_KEY_HEX=<64-hex-char 32-byte seed>
#AUGECOIN_VALIDATOR_KEY_FILE=/opt/augecoin/config/validator.key
AUGECOIN_DEV_MODE=1

AUGECOIN_VALIDATOR_ID=0
AUGECOIN_VALIDATOR_COUNT=4

# ── Chain / storage ───────────────────────────────────────────────────
AUGECOIN_CHAIN_ID=110000
AUGECOIN_DATA_DIR=/opt/augecoin/data/node-0
#AUGECOIN_GENESIS_CONFIG=/opt/augecoin/scripts/genesis/genesis.toml

# ── Networking ────────────────────────────────────────────────────────
# LibP2P listen port.
AUGECOIN_P2P_PORT=9200

# Explicit multiaddr to advertise to peers (NAT / VPS / multi-interface).
# Resolution order: AUGECOIN_EXTERNAL_ADDRESS -> identify.observed_addr -> local.
# 0.0.0.0 / :: are rejected. Must contain /ip4 or /ip6 and /tcp/<port>.
#AUGECOIN_EXTERNAL_ADDRESS=/ip4/203.0.113.10/tcp/9200

# Comma-separated bootnode multiaddrs for discovery.
#AUGECOIN_BOOTNODES=/ip4/127.0.0.1/tcp/9200

# ── HTTP / metrics ────────────────────────────────────────────────────
AUGECOIN_RPC_PORT=9005
AUGECOIN_WALLET_PORT=8081
AUGECOIN_METRICS_PORT=9100

# ── Consensus ─────────────────────────────────────────────────────────
AUGECOIN_BLOCK_TIME=60

# ── Faucet (optional) ─────────────────────────────────────────────────
#AUGECOIN_ENABLE_FAUCET=1
#AUGECOIN_FAUCET_KEY_HEX=<64-hex-char 32-byte seed>
#AUGECOIN_FAUCET_ACCOUNT=<account number>
#AUGECOIN_FAUCET_AMOUNT_AUGE=100

# ── Ops backend (crates/augecoin-ops) ─────────────────────────────────
#AUGECOIN_OPS_DATABASE_URL=postgres://user:pass@localhost:5432/augecoin_ops
#AUGECOIN_OPS_ADMIN_KEY=<shared admin api key>
#AUGECOIN_OPS_LISTEN_ADDR=0.0.0.0:8790
#AUGECOIN_OPS_MAX_CONNECTIONS=5

# Node JSON-RPC bridge (optional; enables validator approve/suspend/revoke).
# When set, the ops service asks the node to sign & submit ValidatorAdmin ops.
#AUGECOIN_OPS_NODE_RPC_URL=http://127.0.0.1:9005
#AUGECOIN_OPS_NODE_ADMIN_KEY=<node admin api key>

# OTA release signing (required to publish releases). Public key only; the
# private key stays in the build pipeline.
#AUGECOIN_OPS_RELEASE_PUBLIC_KEY=<64-hex Ed25519 public key>

# Grafana admin password (infra/observability.yml). Stack binds to 127.0.0.1
# only; change the default before exposing via proxy/tunnel.
#AUGECOIN_GRAFANA_ADMIN_PASSWORD=<strong password>
